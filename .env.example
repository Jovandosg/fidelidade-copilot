# Copie para .env (ignorado pelo git) e troque os valores. Nunca commite senhas reais.
POSTGRES_DB=fidelidade
POSTGRES_USER=fidelidade_owner
POSTGRES_PORT=5432
POSTGRES_PASSWORD=troque-esta-senha-owner
POSTGRES_API_PASSWORD=troque-esta-senha-api
POSTGRES_ETL_PASSWORD=troque-esta-senha-etl
POSTGRES_AUDIT_PASSWORD=troque-esta-senha-audit

# Usado pelo pipeline/carga (usuario dono do schema)
DATABASE_URL=postgresql://fidelidade_owner:troque-esta-senha-owner@127.0.0.1:5432/fidelidade
# Usado pela API da Task5 (usuario somente SELECT)
DATABASE_URL_RO=postgresql://fidelidade_ro:troque-esta-senha-api@127.0.0.1:5432/fidelidade
# Carga ETL (papel fidelidade_etl: escreve raw/treated/analytics; opcional, padrao = DATABASE_URL)
DATABASE_URL_ETL=postgresql://fidelidade_etl:troque-esta-senha-etl@127.0.0.1:5432/fidelidade
# Endpoint de aprovacao da API (papel fidelidade_api_audit: INSERT/SELECT so em ops.audit_log)
DATABASE_URL_AUDIT=postgresql://fidelidade_api_audit:troque-esta-senha-audit@127.0.0.1:5432/fidelidade
# Origens permitidas no CORS da API (separadas por virgula)
CORS_ORIGINS=http://localhost:5173
# Segredo de assinatura dos tokens JWT (>= 32 caracteres aleatorios; o start.ps1 gera um)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-48-caracteres
# Limites por minuto e por IP (opcionais): leitura e escrita (aprovacao)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20
# Login de demonstracao (botoes por perfil na tela de entrada). 0 por padrao; 1 so em ambiente local com dados sinteticos.
DEMO_LOGIN=0
# Agente: provider padrao = regras (sem LLM). Para o LLM real defina as 4 variaveis abaixo, SO no ambiente (nunca no repositorio).
# AGENT_LLM_PROVIDER=llm
# AGENT_LLM_API_KEY=
# AGENT_LLM_BASE_URL=https://...
# AGENT_LLM_MODEL=
