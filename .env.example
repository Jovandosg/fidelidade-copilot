# Copie para .env (ignorado pelo git) e troque os valores. Nunca commite senhas reais.
POSTGRES_DB=fidelidade
POSTGRES_USER=fidelidade_owner
POSTGRES_PORT=5432
POSTGRES_PASSWORD=troque-esta-senha-owner
POSTGRES_API_PASSWORD=troque-esta-senha-api

# Usado pelo pipeline/carga (usuario dono do schema)
DATABASE_URL=postgresql://fidelidade_owner:troque-esta-senha-owner@127.0.0.1:5432/fidelidade
# Usado pela API da Task5 (usuario somente SELECT)
DATABASE_URL_RO=postgresql://fidelidade_ro:troque-esta-senha-api@127.0.0.1:5432/fidelidade
# Origens permitidas no CORS da API (separadas por virgula)
CORS_ORIGINS=http://localhost:5173
