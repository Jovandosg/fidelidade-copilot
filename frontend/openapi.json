  "info": {
    "description": "Dados SINTETICOS. Somente GET; le exclusivamente do PostgreSQL. Sem PII.",
    "title": "Ancora Azul - API de analytics (somente leitura)",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/clientes": {
      "get": {
        "operationId": "clientes_clientes_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "profile",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-E]$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Profile"
            }
          },
          {
            "in": "query",
            "name": "segment",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Segment"
            }
          },
          {
            "in": "query",
            "name": "min_risk",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Risk"
            }
          },
          {
            "in": "query",
            "name": "max_risk",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Risk"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "hvs",
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "desc",
            "required": false,
            "schema": {
              "default": true,
              "title": "Desc",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lista de clientes (paginada)"
      }
    },
    "/clientes/{customer_id}": {
      "get": {
        "operationId": "cliente_clientes__customer_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_id",
            "required": true,
            "schema": {
              "pattern": "^C\\d{6}$",
              "title": "Customer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerFeature"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Perfil e explicacao de um cliente"
      }
    },
    "/kpis": {
      "get": {
        "operationId": "kpis_kpis_get",
        "parameters": [
          {
            "in": "query",
            "name": "risk_threshold",
            "required": false,
            "schema": {
              "default": 40.0,
              "maximum": 100,
              "minimum": 0,
              "title": "Risk Threshold",
              "type": "number"
